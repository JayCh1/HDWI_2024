# Update system...
sudo apt update
sudo apt upgrade

# Install all packages possible from Ubuntu/Debian repositories...
sudo apt install cmake nco ncview netcdf-bin libnetcdf-dev libnetcdff-dev libnetcdf-mpi-dev libnetcdf-pnetcdf-dev libnetcdff7 libpnetcdf-dev python3-cfgrib python3-h5netcdf python3-netcdf4 python3-pandas python3-numpy python3-matplotlib python3-xarray python3-cartopy python-cartopy-data python3-pip unzip imagemagick

# Install the AWS CLI interface...
curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
unzip awscliv2.zip
sudo ./aws/install

# Install non-repository packages...
pip install --break-system-packages metpy cmocean

# Install wgrib2 to parse data files...
export FC=gfortran
export CC=gcc
export CPP=/usr/bin/cpp
export LD_LIBRARY_PATH=/home/ubuntu/grib2/lib:$LD_LIBRARY_PATH
wget https://www.ftp.cpc.ncep.noaa.gov/wd51we/wgrib2/wgrib2.tgz
tar -zxvf wgrib2.tgz
cd grib2/
make
make lib
export PATH=/home/ubuntu/grib2/wgrib2:$PATH
cd

# Then, just run the scripts!
